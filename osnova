
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score
from sklearn.preprocessing import StandardScaler, LabelEncoder
from imblearn.under_sampling import RandomUnderSampler
import warnings
warnings.filterwarnings('ignore')

# Загрузка данных
df = pd.read_csv('credit_card_fraud_10k.csv')

print(f" Данные загружены")
print(f"   Размер: {df.shape[0]} строк, {df.shape[1]} колонок")
print(f"   Колонки: {list(df.columns)}")


print("\n АНАЛИЗ ДАННЫХ:")
print(f"   Мошеннических транзакций: {df['is_fraud'].sum()}")
print(f"   Обычных транзакций: {(df['is_fraud'] == 0).sum()}")
print(f"   Доля мошенничества: {df['is_fraud'].mean()*100:.3f}%")


# Создаем копию данных
data = df.copy()

# Кодируем категориальные признаки
label_encoders = {}
categorical_cols = ['merchant_category']

for col in categorical_cols:
    le = LabelEncoder()
    data[col + '_encoded'] = le.fit_transform(data[col]) #преобразует текст в цифры
    label_encoders[col] = le # запоминаем цифры для слов


# Список признаков для модели
feature_columns = [
    'amount', 'transaction_hour', 'foreign_transaction',
    'location_mismatch', 'device_trust_score', 'velocity_last_24h',
    'cardholder_age', 'merchant_category_encoded'
]

print(f"\nИспользуем {len(feature_columns)} признаков:")
for i, col in enumerate(feature_columns, 1):
    print(f"   {i}. {col}")

# Создаем матрицу признаков и целевую переменную
X = data[feature_columns].values
y = data['is_fraud'].values

# Масштабируем признаки
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

print(f"\n Матрица признаков: {X_scaled.shape[0]} строк, {X_scaled.shape[1]} колонок")



# Разделяем на train/test
X_train, X_test, y_train, y_test = train_test_split(
    X_scaled, y, test_size=0.2, random_state=42, stratify=y
)

print(f"   Размер обучающей выборки: {len(X_train)}")
print(f"   Размер тестовой выборки: {len(X_test)}")

# Балансировка классов
undersampler = RandomUnderSampler(random_state=42)
X_train_balanced, y_train_balanced = undersampler.fit_resample(X_train, y_train)



#обучение модели

model = RandomForestClassifier(
    n_estimators=100,
    max_depth=10,
    random_state=42,
    class_weight='balanced',
    n_jobs=-1
)

model.fit(X_train_balanced, y_train_balanced)


#оценка модели

y_pred = model.predict(X_test)
y_pred_proba = model.predict_proba(X_test)[:, 1]



# Матрица ошибок
conf_matrix = confusion_matrix(y_test, y_pred)
print("\n Матрица ошибок:")
print("              Предсказано")
print("           Обычная  Мошен.")
print(f"Обычная     {conf_matrix[0,0]:6d}   {conf_matrix[0,1]:6d}")
print(f"Мошен.      {conf_matrix[1,0]:6d}   {conf_matrix[1,1]:6d}")



# Создаем DataFrame с важностью признаков
feature_importance = pd.DataFrame({
    'Признак': feature_columns,
    'Важность': model.feature_importances_
}).sort_values('Важность', ascending=False)

print("\nТоп-5 самых важных признаков:")
for i, row in feature_importance.head(5).iterrows():
    print(f"   {i+1}. {row['Признак']:<25} {row['Важность']:.4f} ({row['Важность']*100:.2f}%)")

# Сохранение модели в файл
feature_importance.to_csv('feature_importance.csv', index=False)


import joblib

joblib.dump(model, 'fraud_model.pkl')
joblib.dump(scaler, 'scaler.pkl')
joblib.dump(label_encoders, 'label_encoders.pkl')
joblib.dump(feature_columns, 'feature_columns.pkl')



#тестирование на новых транзакциях

def predict_transaction(transaction_dict, model, scaler, label_encoders, feature_columns):
    """
    Функция для предсказания одной транзакции
    """
    features = []

    for col in feature_columns:
        if col == 'merchant_category_encoded':
            # Для закодированной категории
            category = transaction_dict.get('merchant_category', 'Grocery')
            try:
                val = label_encoders['merchant_category'].transform([category])[0]
            except:
                val = 0
            features.append(val)
        else:
            # Для числовых признаков
            val = transaction_dict.get(col, 0)
            features.append(val)

    # Масштабируем
    features_scaled = scaler.transform([features])

    # Предсказываем
    pred = model.predict(features_scaled)[0]
    proba = model.predict_proba(features_scaled)[0][1]

    return pred, proba
